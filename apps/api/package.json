{
  "name": "@hms/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "node --watch --env-file=.env.dev --import tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env.prod dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/aws-lambda": "^6.4.1",
    "test": "node --env-file=.env.test --import tsx --test test/**/*.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "fastify": "^5.11.2",
    "mongoose": "^9.9.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
    "mongodb-memory-server": "^11.2.0"
  }
}
