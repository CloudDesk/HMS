APP_NAME=hms-api
APP_ENV=test
NODE_ENV=test
HOST=0.0.0.0
PORT=4001
LOG_LEVEL=warn
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=
JWT_ACCESS_TOKEN_SECRET=test-access-token-secret-change-me
JWT_REFRESH_TOKEN_SECRET=test-refresh-token-secret-change-me
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_SECONDS=604800
AUTH_FAILED_LOGIN_LIMIT=5
AUTH_LOCKOUT_MINUTES=15
AUTH_PASSWORD_RESET_TTL_MINUTES=30
AUTH_PASSWORD_MIN_LENGTH=8
AUTH_PASSWORD_REQUIRE_UPPERCASE=true
AUTH_PASSWORD_REQUIRE_LOWERCASE=true
AUTH_PASSWORD_REQUIRE_NUMBER=true
AUTH_PASSWORD_REQUIRE_SYMBOL=false
