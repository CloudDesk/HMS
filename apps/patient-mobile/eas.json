{
  "cli": {
    "version": ">= 16.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_HMS_ENV": "production",
        "EXPO_PUBLIC_HMS_API_URL": "https://hms-api-atok.onrender.com/api"
      }
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_HMS_ENV": "production",
        "EXPO_PUBLIC_HMS_API_URL": "https://hms-api-atok.onrender.com/api"
      }
    }
  }
}
